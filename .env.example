# KryomCode environment template. Copy to .env and fill in real values.
# Never commit .env or real secrets. Placeholders only.
MODEL_API_KEY=your-meta-api-key-here

# Optional model selection. Supported values: muse-spark-1.3 (default),
# muse-wonder-1.0. See https://dev.meta.ai/docs/models for details.
# META_MODEL=muse-spark-1.3

# Optional web search for Research. Built-in providers (arXiv, OpenAlex,
# DuckDuckGo) need no key. Set this only to enable Tavily web results.
# TAVILY_API_KEY=your-tavily-key-here
